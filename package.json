{
  "name": "relationship-mermaid",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build viewer.ts --outfile viewer.js",
    "dev": "bash -c 'trap \"kill \\$(jobs -p)\" EXIT; bun build viewer.ts --outfile viewer.js --watch & bun --watch server.ts \"$@\" & wait' dev",
    "test:file": "node --test --test-global-setup=tests/global-browser-setup.ts --test-timeout=120000",
    "test": "node --test --test-global-setup=tests/global-browser-setup.ts --test-concurrency=1 --test-timeout=120000 \"tests/**/*.test.ts\" \"*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.5.1"
  },
  "dependencies": {
    "mermaid": "^12.0.0",
    "typescript": "6.0.3"
  }
}
