{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    // "types": ["node"],
    "types": ["node", "bun"],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  // "include": ["viewer.ts", "tests", "*.test.ts"],
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
